<%# Everything here comes from declarations, translations or the database, escaped by ERB: no sentence comes from the LLM (ADR 0001 D5). %>
<% case outcome.status %>
<% when :answered %>
  <% result = outcome.result %>
  <% if result.respond_to?(:list?) %>
  <%= render "data_teller/questions/list", outcome: outcome %>
  <% else %>
  <p class="dt-understood">
    <%= outcome.query["dataset"] %> · <%= outcome.query["metric"] %><% if result.period %> · <%= result.period.first %> → <%= result.period.last - 1 %><% end %>
  </p>
  <%# Every group hidden is not "nothing matches": the note below says why the table is empty (ADR 0012 D3). %>
  <% if result.rows.empty? && result.suppressed.zero? %>
    <p class="dt-message"><%= t("data_teller.outcome.no_rows") %></p>
  <% elsif result.rows.any? %>
    <table class="dt-result">
      <thead><tr><% result.columns.each do |column| %><th scope="col"><%= column %></th><% end %></tr></thead>
      <tbody>
        <% result.rows.each do |row| %>
          <tr><% row.each do |value| %><td><%= value %></td><% end %></tr>
        <% end %>
      </tbody>
    </table>
    <% if result.truncated %><p class="dt-note"><%= t("data_teller.outcome.truncated", count: result.rows.size) %></p><% end %>
  <% end %>
  <%# How many, never which: the labels of the hidden groups are data too. %>
  <% if result.suppressed.positive? %><p class="dt-note"><%= t("data_teller.outcome.suppressed", count: result.suppressed) %></p><% end %>
  <% end %>
<% when :clarify %>
  <p class="dt-message"><%= t("data_teller.outcome.clarify") %></p>
  <ul class="dt-options"><% outcome.query.dig("clarify", "options").each do |option| %><li><%= option %></li><% end %></ul>
<% when :out_of_scope %>
  <p class="dt-message"><%= t("data_teller.refusal.#{outcome.query.dig('out_of_scope', 'reason')}") %></p>
<% else %>
  <p class="dt-message"><%= t("data_teller.refusal.#{outcome.refusal.reason}") %></p>
<% end %>
