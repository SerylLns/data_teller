{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data_teller.dev/schema/query_v1.json",
  "title": "DataTeller structured query, version 1",
  "description": "Static structure only. Names (dataset, metric, dimensions, segments) are checked against the developer's declarations by the validator, and by a schema generated from the registry (T08). Date dimensions are rejected in filters by the validator (ADR 0001 D1).",
  "type": "object",
  "required": [
    "version",
    "intent"
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/answer"
    },
    {
      "$ref": "#/$defs/list"
    },
    {
      "$ref": "#/$defs/clarify"
    },
    {
      "$ref": "#/$defs/out_of_scope"
    }
  ],
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,2}$",
      "maxLength": 80
    },
    "iso_date": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "intent",
        "dataset",
        "metric"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "intent": {
          "const": "answer"
        },
        "dataset": {
          "$ref": "#/$defs/name"
        },
        "metric": {
          "$ref": "#/$defs/name"
        },
        "period": {
          "$ref": "#/$defs/period"
        },
        "filters": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/filter"
          }
        },
        "group_by": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/group_by_item"
          }
        },
        "order_by": {
          "$ref": "#/$defs/order_by"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "compare": {
          "enum": [
            "previous_period",
            "previous_year"
          ]
        }
      },
      "dependentRequired": {
        "compare": [
          "period"
        ]
      }
    },
    "list": {
      "description": "An answer that shows rows instead of a metric (ADR 0016). Columns are dimensions; none means the dataset's default.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "intent",
        "dataset",
        "list"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "intent": {
          "const": "answer"
        },
        "dataset": {
          "$ref": "#/$defs/name"
        },
        "list": {
          "const": true
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "period": {
          "$ref": "#/$defs/period"
        },
        "filters": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/filter"
          }
        },
        "order_by": {
          "$ref": "#/$defs/list_order_by"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "clarify": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "intent",
        "clarify"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "intent": {
          "const": "clarify"
        },
        "clarify": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "options"
          ],
          "properties": {
            "reason": {
              "enum": [
                "ambiguous_period",
                "ambiguous_metric",
                "ambiguous_dataset",
                "ambiguous_dimension",
                "ambiguous_entity",
                "ambiguous_segment",
                "missing_period"
              ]
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/name"
              }
            }
          }
        }
      }
    },
    "out_of_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "intent",
        "out_of_scope"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "intent": {
          "const": "out_of_scope"
        },
        "out_of_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "enum": [
                "unknown_dataset",
                "unknown_metric",
                "unsupported_query",
                "not_a_data_question"
              ]
            }
          }
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "range"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/name"
        },
        "range": {
          "$ref": "#/$defs/range"
        }
      }
    },
    "range": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relative"
          ],
          "properties": {
            "relative": {
              "enum": [
                "today",
                "yesterday",
                "tomorrow",
                "this_week",
                "last_week",
                "next_week",
                "this_month",
                "last_month",
                "next_month",
                "this_quarter",
                "last_quarter",
                "next_quarter",
                "this_year",
                "last_year"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "last"
          ],
          "properties": {
            "last": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "n",
                "unit"
              ],
              "properties": {
                "n": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 366
                },
                "unit": {
                  "enum": [
                    "day",
                    "week",
                    "month",
                    "year"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "on"
          ],
          "properties": {
            "on": {
              "$ref": "#/$defs/iso_date"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "between"
          ],
          "properties": {
            "between": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "$ref": "#/$defs/iso_date"
                },
                "to": {
                  "$ref": "#/$defs/iso_date"
                }
              }
            }
          }
        }
      ]
    },
    "scalar": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lookup"
          ],
          "properties": {
            "lookup": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      ]
    },
    "filter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "segment"
          ],
          "properties": {
            "segment": {
              "$ref": "#/$defs/name"
            }
          }
        },
        {
          "$ref": "#/$defs/comparison"
        }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "op"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/name"
        },
        "op": {
          "enum": [
            "eq",
            "not_eq",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "not_in",
            "contains",
            "is_null",
            "is_not_null"
          ]
        },
        "value": {
          "oneOf": [
            {
              "$ref": "#/$defs/scalar"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "$ref": "#/$defs/scalar"
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "in",
                  "not_in"
                ]
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "eq",
                  "not_eq",
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "contains"
                ]
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "not": {
                  "type": "array"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "is_null",
                  "is_not_null"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ]
    },
    "group_by_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/name"
        },
        "granularity": {
          "enum": [
            "day",
            "week",
            "month",
            "quarter",
            "year"
          ]
        }
      }
    },
    "list_order_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "dimension",
        "dir"
      ],
      "properties": {
        "by": {
          "const": "dimension"
        },
        "dimension": {
          "$ref": "#/$defs/name"
        },
        "dir": {
          "enum": [
            "asc",
            "desc"
          ]
        }
      }
    },
    "order_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "dir"
      ],
      "properties": {
        "by": {
          "enum": [
            "metric",
            "dimension"
          ]
        },
        "dimension": {
          "$ref": "#/$defs/name"
        },
        "dir": {
          "enum": [
            "asc",
            "desc"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "by": {
                "const": "dimension"
              }
            }
          },
          "then": {
            "required": [
              "dimension"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "by": {
                "const": "metric"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "dimension"
              ]
            }
          }
        }
      ]
    }
  }
}
